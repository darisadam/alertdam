# =============================================================================
# AlertDam — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development         # development | staging | production
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_LOG_LEVEL=info          # debug | info | warn | error

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://alertdam:password@localhost:5432/alertdam?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=5m

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
JWT_SECRET=REPLACE_ME_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRY=24h

# OAuth2 / OIDC (optional — for SSO)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ISSUER_URL=            # e.g., https://accounts.google.com

# SAML 2.0 (optional — for enterprise SSO)
SAML_ENTITY_ID=
SAML_IDP_METADATA_URL=
SAML_CERT_PATH=

# -----------------------------------------------------------------------------
# Chat Integrations
# -----------------------------------------------------------------------------

# Slack
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
SLACK_SIGNING_SECRET=REPLACE_ME
SLACK_APP_TOKEN=xapp-REPLACE_ME   # For Socket Mode

# Discord
DISCORD_BOT_TOKEN=REPLACE_ME
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# Telegram
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_WEBHOOK_URL=${APP_BASE_URL}/webhooks/telegram

# Microsoft Teams
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=

# WhatsApp Business API
WHATSAPP_API_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=REPLACE_ME

# -----------------------------------------------------------------------------
# Telephony (Twilio) — Bring Your Own Keys
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACREPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx   # Your Twilio phone number
TWILIO_TWIML_APP_SID=              # For SIP/WebRTC

# -----------------------------------------------------------------------------
# Mobile Push Notifications
# -----------------------------------------------------------------------------

# Firebase Cloud Messaging (FCM) — Android
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=./service-account.json

# Apple Push Notification Service (APNs) — iOS
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_FILE=./AuthKey_XXXXXXXX.p8
APNS_BUNDLE_ID=com.alertdam.mobile
APNS_PRODUCTION=false              # true in production

# -----------------------------------------------------------------------------
# Monitoring Integrations
# -----------------------------------------------------------------------------

# Prometheus Alertmanager webhook (incoming)
ALERTMANAGER_WEBHOOK_SECRET=REPLACE_ME

# Grafana
GRAFANA_API_KEY=

# Datadog
DATADOG_API_KEY=
DATADOG_APP_KEY=

# PagerDuty Events API (for bi-directional sync, optional)
PAGERDUTY_ROUTING_KEY=

# -----------------------------------------------------------------------------
# War Room Automation
# -----------------------------------------------------------------------------

# Zoom (auto-create meeting for P1 incidents)
ZOOM_API_KEY=
ZOOM_API_SECRET=
ZOOM_ACCOUNT_ID=

# Google Meet
GOOGLE_MEET_CREDENTIALS_FILE=

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@alertdam.example.com
SMTP_TLS=true

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_DISCORD=true
FEATURE_TELEGRAM=true
FEATURE_SLACK=true
FEATURE_TEAMS=false
FEATURE_WHATSAPP=false
FEATURE_TWILIO_VOICE=false
FEATURE_WAR_ROOM=false
