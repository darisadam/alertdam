# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go uses tabs, and gofmt will fight anything else.
[*.go]
indent_style = tab
indent_size = 4

[go.mod]
indent_style = tab

# Make requires tabs for recipe lines.
[{Makefile,makefile,*.mk}]
indent_style = tab

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,scss,html,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.dart]
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 2

# Two trailing spaces are a meaningful line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Generated / vendored — do not reformat.
[{package-lock.json,pubspec.lock,go.sum}]
insert_final_newline = unset
trim_trailing_whitespace = unset
